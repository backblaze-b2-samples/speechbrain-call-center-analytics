# Backblaze B2 (required)
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# B2 region — the S3 endpoint is derived from it
# (https://s3.<region>.backblazeb2.com). Find it on your bucket's detail page.
B2_REGION=us-west-004

# Optional: public base URL for a PUBLIC bucket, used only to build public
# object URLs. Leave unset for private buckets — the app uses presigned URLs.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-004.backblazeb2.com

# Example of what filled-in values look like (placeholders — not real keys):
# B2_APPLICATION_KEY_ID=your-25-char-key-id
# B2_APPLICATION_KEY=your-31-char-application-key
# B2_BUCKET_NAME=my-call-recordings
# B2_REGION=us-west-004

# SpeechBrain runs fully on-device. Device is auto-detected (CUDA -> Apple MPS
# -> CPU). Pin it here if needed — e.g. set to "cpu" if an MPS op errors on
# Apple silicon (wav2vec2 has incomplete MPS coverage).
# SPEECHBRAIN_DEVICE=cpu

# Where SpeechBrain caches the (~1-2 GB) pretrained models. Defaults to
# ~/.cache/sb-ccanalytics. Point at a persistent volume in production.
# SPEECHBRAIN_CACHE=/var/cache/speechbrain

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
